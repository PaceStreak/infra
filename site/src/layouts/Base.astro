---
import "../styles/global.css";
// Preloaded so the first paint already uses Archivo: text drawn in a fallback
// font and re-wrapped when Archivo arrived would be a layout shift.
import archivoUrl from "@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url";
import Logo from "../components/Logo.astro";
import { navGroups, SITES } from "../lib/nav";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const here = Astro.url.pathname.replace(/\.html$/, "").replace(/\/$/, "") || "/";
const groups = await navGroups();
const fullTitle = title === "PaceStreak docs" ? title : `${title} · PaceStreak docs`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafaf9" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PaceStreak docs" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <!-- Blocking on purpose and external on purpose: sets data-theme before
         first paint, which an inline script would do but the CSP forbids. -->
    <script is:inline src="/theme.js"></script>
    <link rel="stylesheet" href="/code.css" />
  </head>

  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>

    <header class="topbar">
      <div class="topbar__inner">
        <button
          class="icon-btn menu-btn"
          type="button"
          aria-controls="sidebar"
          aria-expanded="false"
          aria-label="Open navigation"
        >
          <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
            <path d="M3 5h14M3 10h14M3 15h14" class="i-stroke"></path>
          </svg>
        </button>
        <a class="brand" href="/" aria-label="PaceStreak docs, home">
          <Logo />
          <span class="brand__word">
            Pace<span class="brand__accent">Streak</span>
          </span>
          <span class="brand__tag">docs</span>
        </a>
        <button
          class="search-trigger"
          type="button"
          aria-haspopup="dialog"
          aria-controls="search"
        >
          <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
            <circle cx="9" cy="9" r="5.5" class="i-stroke"></circle>
            <path d="m13.5 13.5 3.5 3.5" class="i-stroke"></path>
          </svg>
          <span class="search-trigger__label">Search docs</span>
          <kbd class="search-trigger__kbd">/</kbd>
        </button>
        <button class="icon-btn theme-btn" type="button" aria-label="Theme: system">
          <svg
            class="theme-ic theme-ic--system"
            viewBox="0 0 20 20"
            width="18"
            height="18"
            aria-hidden="true"
          >
            <rect x="3" y="4" width="14" height="10" rx="2" class="i-stroke"></rect>
            <path d="M7 17h6" class="i-stroke"></path>
          </svg>
          <svg
            class="theme-ic theme-ic--light"
            viewBox="0 0 20 20"
            width="18"
            height="18"
            aria-hidden="true"
          >
            <circle cx="10" cy="10" r="3.5" class="i-stroke"></circle>
            <path
              d="M10 2v2M10 16v2M2 10h2M16 10h2M4.3 4.3l1.4 1.4M14.3 14.3l1.4 1.4M4.3 15.7l1.4-1.4M14.3 5.7l1.4-1.4"
              class="i-stroke"
            ></path>
          </svg>
          <svg
            class="theme-ic theme-ic--dark"
            viewBox="0 0 20 20"
            width="18"
            height="18"
            aria-hidden="true"
          >
            <path
              d="M16 12.5A6.5 6.5 0 0 1 7.5 4a6.5 6.5 0 1 0 8.5 8.5Z"
              class="i-stroke"
            ></path>
          </svg>
        </button>
        <a
          class="icon-btn gh-link"
          href="https://github.com/PaceStreak/infra"
          aria-label="PaceStreak/infra on GitHub"
        >
          <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true">
            <path
              class="i-fill"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            ></path>
          </svg>
        </a>
      </div>
    </header>

    <div class="shell">
      <div class="scrim" hidden></div>
      <aside id="sidebar" class="sidebar">
        <nav aria-label="Documentation">
          {groups.map((g) => (
            <details class="nav-group" open>
              <summary class="nav-group__title">{g.title}</summary>
              <ul class="nav-group__list">
                {g.items.map((item) => (
                  <li>
                    <a
                      class="nav-link"
                      href={item.href}
                      aria-current={item.href === here ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </nav>
      </aside>

      <main id="main" class="main" tabindex="-1">
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <div class="site-footer__brand">
          <p class="site-footer__name">
            <Logo size={20} />
            <span>
              Pace<span class="brand__accent">Streak</span> docs
            </span>
          </p>
          <p class="site-footer__note">
            Built from the Markdown in{" "}
            <a href="https://github.com/PaceStreak/infra">PaceStreak/infra</a>.
            AGPL-3.0.
          </p>
        </div>
        <nav aria-label="PaceStreak sites" class="site-footer__nav">
          <ul>
            {SITES.map((s) => (
              <li>
                <a href={s.href}>{s.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
      <p class="site-footer__legal">&copy; {year} PaceStreak</p>
    </footer>

    <dialog id="search" class="search" aria-labelledby="search-title">
      <h2 id="search-title" class="sr-only">
        Search the documentation
      </h2>
      <form class="search__form" method="dialog" role="search">
        <svg
          viewBox="0 0 20 20"
          width="18"
          height="18"
          aria-hidden="true"
          class="search__icon"
        >
          <circle cx="9" cy="9" r="5.5" class="i-stroke"></circle>
          <path d="m13.5 13.5 3.5 3.5" class="i-stroke"></path>
        </svg>
        <input
          id="search-input"
          class="search__input"
          type="search"
          role="combobox"
          aria-expanded="false"
          aria-controls="search-results"
          aria-autocomplete="list"
          aria-label="Search"
          autocomplete="off"
          spellcheck="false"
          placeholder="Search runbooks, decisions, DNS…"
        />
        <button class="search__close" value="close" aria-label="Close search">
          Esc
        </button>
      </form>
      <ul
        id="search-results"
        class="search__results"
        role="listbox"
        aria-label="Results"
      ></ul>
      <p class="search__status" role="status" aria-live="polite"></p>
      <p class="search__help" aria-hidden="true">
        <span>
          <kbd>↑</kbd> <kbd>↓</kbd> move
        </span>
        <span>
          <kbd>Enter</kbd> open
        </span>
        <span>
          <kbd>Esc</kbd> close
        </span>
      </p>
    </dialog>

    <p id="announcer" class="sr-only" role="status" aria-live="polite"></p>

    <script>
      import "../scripts/main.ts";
    </script>
  </body>
</html>
